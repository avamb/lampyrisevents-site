# Build-time settings. All values are PUBLIC. Copy to .env for local work.
SITE_URL=https://lampyrisevents.com
# false (default) on staging: every page gets noindex, robots.txt disallows everything.
SITE_INDEXING=false
# fixture (default, data/snapshot) or feed (platform feed).
DATA_SOURCE=fixture
PUBLIC_ARENA_API=https://api.arenasoldout.com
PUBLIC_FEED_TOKEN=
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_ID=
PUBLIC_TURNSTILE_SITE_KEY=
# Inline ticket widget on /tickets/<event>/: script address and the API base the browser calls (unset = PUBLIC_ARENA_API, empty = same origin).
PUBLIC_ARENA_WIDGET_URL=https://tickets.arenasoldout.com/widget/v1/arena-tickets.js
PUBLIC_ARENA_WIDGET_API=https://api.arenasoldout.com
# Dev only: proxy of /v1 to an API for the widget when PUBLIC_ARENA_WIDGET_API is empty.
DEV_API_PROXY=

---
/** Home pages of the prefixed languages (/cs/ ...): the "Actual events" list. */
import HomeList from '../../components/HomeList.astro';
import { languages } from '../../../site.config.ts';

export function getStaticPaths() {
  return languages.filter((l) => l.prefix).map((l) => ({ params: { lang: l.code }, props: { lang: l.code } }));
}
const { lang } = Astro.props;
---
<HomeList lang={lang} />

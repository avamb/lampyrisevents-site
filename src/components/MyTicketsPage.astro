---
/**
 * "My tickets" page (/my-tickets/ and /<lang>/my-tickets/). Personal page: noindex, no tracking.
 * The island asks for an e-mailed link (Turnstile) and lists the orders of the 4-hour session.
 */
import '../styles/personal.css';
import Base from '../layouts/Base.astro';
import MyTickets from './islands/MyTickets.svelte';
import { ui, language } from '../lib/i18n.ts';
import { pagePath, pageAlternatesMap } from '../lib/routes.ts';
import { arena, siteUrl, turnstile } from '../../site.config.ts';

interface Props { lang: string; }
const { lang } = Astro.props;
const t = ui(lang);
const title = t.account.myTickets;
---
<Base lang={lang} title={title} switcher={pageAlternatesMap('myTickets')} personal>
  <div class="lp-container lp-main">
    <section class="lp-personal">
      <h1>{title}</h1>
      <div class="lp-personal__box">
        <MyTickets
          client:load
          t={t.account}
          errors={{ ...t.errors, ...t.forms.errors }}
          emailLabel={t.forms.email}
          loadingLabel={t.common.loading}
          moreLabel={t.common.loadMore}
          sendingLabel={t.forms.sending}
          apiBase={arena.apiBase}
          feedToken={arena.feedToken}
          siteKey={turnstile.siteKey}
          lang={lang}
          intl={language(lang).intl}
          pageUrl={new URL(pagePath('myTickets', lang), siteUrl).href}
          homePath={pagePath('home', lang)}
        />
      </div>
    </section>
  </div>
</Base>

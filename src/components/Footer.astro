---
/** Partner strip (Kudyznudy), then the footer: contacts, three link columns, copyright with company numbers, socials. */
import { brand } from '../../site.config.ts';
import { pagePath, pageTitles } from '../lib/routes.ts';
import { ui } from '../lib/i18n.ts';
import Icon from './Icon.astro';

interface Props { lang: string; current: string; }
const { lang, current } = Astro.props;
const t = ui(lang);
const link = (key: string, label: string) => ({ href: pagePath(key, lang), label });
const columns = [
  {
    title: t.footer.forBuyers,
    links: [
      link('myTickets', t.account.title),
      link('how-to-buy', t.nav.howToBuy),
      link('frequently-asked-questions', t.nav.faq),
      link('terms-of-use', t.footer.terms),
      link('privacy-policy', t.footer.privacy),
    ],
  },
  {
    title: t.footer.forOrganizers,
    links: [
      link('sell-tickets-with-us', t.nav.sellTickets),
      link('create-event', pageTitles['create-event']?.[lang] || pageTitles['create-event']?.en || 'Create event'),
      link('partnerships', t.nav.partnerships),
    ],
  },
  {
    title: 'Lampyris Events',
    links: [link('about-us', t.nav.aboutUs), link('contacts', t.nav.contacts)],
  },
];
const copyright = t.footer.copyright.replace('{year}', String(new Date().getFullYear()));
---
<div class="lp-partner">
  <a href={brand.partnerLogo.href} target="_blank" rel="noopener" title="Kudyznudy.cz">
    <img src={brand.partnerLogo.src} alt={brand.partnerLogo.alt} width="150" height="33" loading="lazy" decoding="async" />
  </a>
</div>
<footer class="lp-footer">
  <div class="lp-container lp-footer__grid">
    <div class="lp-footer__brand">
      <img src="/_site/img/logo.svg" alt={brand.name} width="190" height="48" loading="lazy" />
      <p><a href={`mailto:${brand.email}`}>{brand.email}</a></p>
      <p><a href={`tel:${brand.phoneHref}`}>{brand.phone}</a></p>
    </div>
    {columns.map((c) => (
      <nav aria-label={c.title}>
        <h3>{c.title}</h3>
        <ul>
          {c.links.map((l) => <li><a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <div class="lp-footer__bar">
    <div class="lp-container lp-footer__bar-inner">
      <p class="lp-footer__copy">{copyright} · IČO {brand.registryCode} · DIČ {brand.vat}</p>
      <div class="lp-social">
        <a href={brand.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>
        <a href={brand.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
        <a href={brand.telegram} target="_blank" rel="noopener" aria-label="Telegram"><Icon name="telegram" /></a>
      </div>
    </div>
  </div>
</footer>

---
/**
 * Generic content page: the cleaned WordPress HTML (trusted, own export) in the site frame.
 * Props: pageKey (page key of routes.ts), lang. Pages in SIDEBAR get the "for buyers / organizers" menu on the left.
 * Without an <h1> in the HTML the page title is shown as <h1>.
 */
import Base from './Base.astro';
import SiteForm from '../components/SiteForm.astro';
import { genericPage } from '../lib/pages.ts';
import { pageAlternatesMap, pageHreflang, pagePath, pageTitles } from '../lib/routes.ts';
import { ui } from '../lib/i18n.ts';

interface Props { pageKey: string; lang: string; }
const { pageKey, lang } = Astro.props;
const page = genericPage(pageKey, lang);
const t = ui(lang);
const current = Astro.url.pathname;
const SIDEBAR = ['about-us'];
const side = SIDEBAR.includes(pageKey);
// The WordPress "#popup" buttons open a form: here it sits under the text, the buttons jump to it.
const FORMS: Record<string, 'contact' | 'partnership'> = { contacts: 'contact', partnerships: 'partnership' };
const formKind = FORMS[pageKey];
const html = formKind ? page.html.replaceAll('href="#popup"', `href="#${formKind}"`) : page.html;
const link = (key: string, label: string) => ({ href: pagePath(key, lang), label });
const createLabel = pageTitles['create-event']?.[lang] || pageTitles['create-event']?.en || '';
const menus = [
  {
    title: t.footer.forBuyers,
    links: [link('myTickets', t.account.title), link('how-to-buy', t.nav.howToBuy), link('frequently-asked-questions', t.nav.faq), link('terms-of-use', t.footer.terms), link('privacy-policy', t.footer.privacy)],
  },
  {
    title: t.footer.forOrganizers,
    links: [link('sell-tickets-with-us', t.nav.sellTickets), link('create-event', createLabel), link('partnerships', t.nav.partnerships)],
  },
  { title: 'Lampyris-Events', links: [link('about-us', t.nav.aboutUs), link('contacts', t.nav.contacts)] },
];
---
<Base lang={lang} title={page.title} alternates={pageHreflang(pageKey, page.available)} switcher={pageAlternatesMap(pageKey)}>
  <div class="lp-container lp-main">
    <div class={side ? 'lp-page lp-page--side' : 'lp-page'}>
      {side && (
        <aside class="lp-page__side">
          {menus.map((m) => (
            <>
              <h2>{m.title}</h2>
              <ul>{m.links.map((l) => <li><a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>)}</ul>
            </>
          ))}
        </aside>
      )}
      <article class="lp-prose" lang={page.contentLang}>
        {!page.hasH1 && <h1>{page.title}</h1>}
        <Fragment set:html={html} />
        {formKind && <SiteForm lang={lang} kind={formKind} />}
      </article>
    </div>
  </div>
</Base>
